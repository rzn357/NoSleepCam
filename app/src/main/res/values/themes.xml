<resources>
    <!--
        The UI is always dark and black: a black window and black system bars, so that nothing flickers between launch and the first
        camera frame. The theme does not depend on AppCompat/Material — this is faster on a cold start.
    -->
    <style name="Theme.NoSleepCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>
</resources>
