{
    "enabledMcpjsonServers": ["chrome-devtools"],
    "hooks": {
        "PermissionRequest": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File \"$CLAUDE_PROJECT_DIR\\.claude\\notify-toast.ps1\""
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File \"$CLAUDE_PROJECT_DIR\\.claude\\notify-toast.ps1\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "AskUserQuestion|ExitPlanMode",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File \"$CLAUDE_PROJECT_DIR\\.claude\\notify-toast.ps1\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File \"$CLAUDE_PROJECT_DIR\\.claude\\notify-toast.ps1\""
                    }
                ]
            }
        ]
    }
}
